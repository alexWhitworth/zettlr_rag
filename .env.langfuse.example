# .env.langfuse.example
# Copy to .env.langfuse and fill in after creating a project at http://localhost:3000

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# Set to "true" to log full prompt/completion text to Langfuse
# Set to "false" in environments with sensitive document content
LANGFUSE_PROMPT_LOGGING_ENABLED=true

# Set to "true" to enable streaming mode (required for TTFT measurement)
RAG_STREAMING_ENABLED=false
